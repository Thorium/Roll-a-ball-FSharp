<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>..\Assets\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Unity Path Detection -->
  <PropertyGroup>
    <UnityPath Condition="'$(UNITY_PATH)' != ''">$(UNITY_PATH)</UnityPath>
    <UnityPath Condition="'$(UnityPath)' == '' AND Exists('C:\Program Files\Unity\Editor')">C:\Program Files\Unity\Editor</UnityPath>
    <UnityPath Condition="'$(UnityPath)' == '' AND Exists('C:\Program Files\Unity\Hub\Editor')">C:\Program Files\Unity\Hub\Editor</UnityPath>
    <UnityPath Condition="'$(UnityPath)' == '' AND Exists('/Applications/Unity/Unity.app/Contents')">/Applications/Unity/Unity.app/Contents</UnityPath>
    <UnityPath Condition="'$(UnityPath)' == '' AND Exists('/Applications/Unity/Hub/Editor')">/Applications/Unity/Hub/Editor</UnityPath>
    <UnityPath Condition="'$(UnityPath)' == ''">$(MSBuildProjectDirectory)\..\UnityEngine</UnityPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="RollABall.fs" />
    <None Include="Script.fsx" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(UnityPath)\Data\Managed\UnityEngine.dll')">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityPath)\Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(UnityPath)\Data\UnityExtensions\Unity\GUISystem\UnityEngine.UI.dll')">
      <HintPath>$(UnityPath)\Data\UnityExtensions\Unity\GUISystem\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Fallback references if Unity isn't found -->
  <ItemGroup Condition="!Exists('$(UnityPath)\Data\Managed\UnityEngine.dll')">
    <PackageReference Include="Unity3D.UnityEngine" Version="2019.4.40" PrivateAssets="all" />
  </ItemGroup>

</Project>